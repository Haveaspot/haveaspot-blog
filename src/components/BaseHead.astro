---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE_NAME, DEFAULT_IMAGE_ALT } from "../consts";
import { organizationSchema, websiteSchema } from "../lib/seo";

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	type?: "website" | "article";
	pubDate?: Date;
	updatedDate?: Date;
	/** Extra schema.org nodes for this page (BlogPosting, BreadcrumbList...). */
	schema?: Record<string, unknown>[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// AMENDED: Changed default fallback image to your new social preview asset
const {
	title,
	description,
	image = "/default-social-preview.png",
	imageAlt = DEFAULT_IMAGE_ALT,
	noindex = false,
	type = "website",
	pubDate,
	updatedDate,
	schema = [],
} = Astro.props;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [organizationSchema, websiteSchema, ...schema],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="format-detection" content="telephone=no" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
<meta name="theme-color" content="#021300" />
<meta name="author" content={SITE_NAME} />

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_GB" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:alt" content={imageAlt} />
{type === "article" && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{type === "article" && (updatedDate ?? pubDate) && <meta property="article:modified_time" content={(updatedDate ?? pubDate)!.toISOString()} />}
{type === "article" && <meta property="article:author" content={SITE_NAME} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="alternate" type="application/rss+xml" title="Haveaspot Blog" href="/rss.xml" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site summary" />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

<ClientRouter />

{/* First-party, cookieless analytics (CRM: /analytics). Stores nothing in the browser. */}
<script is:inline defer src="https://api.haveaspot.com/v1/hs.js"></script>

